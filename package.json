{
  "name": "matin-converter",
  "version": "1.1.1",
  "description": "Offline Windows image converter",
  "main": "dist/main/main/main.js",
  "author": "Matin Converter",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatinDP/MatinConverter.git"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "icon:prepare": "node scripts/prepare-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "dist:win": "npm run icon:prepare && npm run build && electron-builder --win nsis",
    "native:win": "cmake -S native/shell-extension -B native/shell-extension/build -A x64 && cmake --build native/shell-extension/build --config Release"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.matin.converter",
    "productName": "Matin Converter",
    "artifactName": "Matin-Converter-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "MatinDP",
        "repo": "MatinConverter"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "packaging/nsis/hooks.nsh"
    }
  }
}
