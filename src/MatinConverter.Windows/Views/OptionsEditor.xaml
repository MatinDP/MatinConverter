<UserControl x:Class="MatinConverter.Windows.Views.OptionsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:MatinConverter.Core;assembly=MatinConverter.Core">
 <StackPanel>
  <TextBlock Text="{DynamicResource Format}" Style="{StaticResource Label}"/>
  <ComboBox x:Name="FormatBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Format,UpdateSourceTrigger=PropertyChanged}" SelectionChanged="FormatChanged" FlowDirection="LeftToRight" AutomationProperties.Name="Output format"/>
  <StackPanel x:Name="QualityPanel"><Grid Margin="0,12,0,4"><TextBlock Text="{DynamicResource Quality}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Quality}" HorizontalAlignment="Right" FlowDirection="LeftToRight"/></Grid><Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Quality,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output quality"/></StackPanel>
  <TextBlock Text="{DynamicResource Destination}" Style="{StaticResource Label}"/>
  <ComboBox x:Name="DestinationBox" SelectedValuePath="Tag" SelectedValue="{Binding Destination}" SelectionChanged="DestinationChanged" AutomationProperties.Name="Output destination">
   <ComboBoxItem Tag="{x:Static c:DestinationMode.Source}" Content="{DynamicResource SameFolder}"/><ComboBoxItem Tag="{x:Static c:DestinationMode.Custom}" Content="{DynamicResource CustomFolder}"/><ComboBoxItem Tag="{x:Static c:DestinationMode.Subfolder}" Content="{DynamicResource Subfolder}"/>
  </ComboBox>
  <StackPanel x:Name="CustomPanel" Visibility="Collapsed"><TextBox Text="{Binding OutputDirectory,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,4,0,8" AutomationProperties.Name="Output directory"/><Button Content="{DynamicResource Browse}" Click="BrowseFolder" HorizontalAlignment="Left"/></StackPanel>
  <StackPanel x:Name="SubfolderPanel" Visibility="Collapsed"><TextBlock Text="{DynamicResource SubfolderName}" Style="{StaticResource Label}"/><TextBox Text="{Binding Subfolder,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output subfolder name"/></StackPanel>
  <Expander Header="{DynamicResource Advanced}"><StackPanel Margin="0,8,0,0">
   <TextBlock Text="{DynamicResource ResizeMode}" Style="{StaticResource Label}"/>
   <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Resize}"><ComboBoxItem Tag="{x:Static c:ResizeMode.FitInside}" Content="{DynamicResource FitInside}"/><ComboBoxItem Tag="{x:Static c:ResizeMode.Original}" Content="{DynamicResource OriginalSize}"/><ComboBoxItem Tag="{x:Static c:ResizeMode.Cover}" Content="{DynamicResource Cover}"/><ComboBoxItem Tag="{x:Static c:ResizeMode.Exact}" Content="{DynamicResource Exact}"/></ComboBox>
   <TextBlock Text="{DynamicResource CropHint}" Style="{StaticResource Muted}" FontSize="12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Width}" Style="{StaticResource Label}"/><TextBox Text="{Binding Width,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" FlowDirection="LeftToRight" AutomationProperties.Name="Output width"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Height}" Style="{StaticResource Label}"/><TextBox Text="{Binding Height,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" FlowDirection="LeftToRight" AutomationProperties.Name="Output height"/></StackPanel></Grid>
   <TextBlock Text="{DynamicResource TargetSize}" Style="{StaticResource Label}"/><TextBox Text="{Binding TargetSizeKiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" FlowDirection="LeftToRight"/>
   <TextBlock Text="{DynamicResource MinQuality}" Style="{StaticResource Label}"/><TextBox Text="{Binding MinimumQuality,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" FlowDirection="LeftToRight"/><TextBlock Text="{DynamicResource TargetHint}" Style="{StaticResource Muted}" FontSize="12"/><CheckBox Content="{DynamicResource TargetDownsize}" IsChecked="{Binding AllowTargetDownsize}"/>
   <CheckBox Content="{DynamicResource Aspect}" IsChecked="{Binding PreserveAspect}"/><CheckBox Content="{DynamicResource Enlarge}" IsChecked="{Binding AllowEnlargement}"/>
   <TextBlock Text="{DynamicResource Background}" Style="{StaticResource Label}"/><TextBox Text="{Binding Background,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="JPEG background hex color"/>
   <CheckBox Content="{DynamicResource Strip}" IsChecked="{Binding StripMetadata}"/><TextBlock Text="{DynamicResource MetadataHint}" Style="{StaticResource Muted}" FontSize="12"/>
   <TextBlock Text="{DynamicResource Frames}" Style="{StaticResource Label}"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Frames}" AutomationProperties.Name="Multiple frame policy"><ComboBoxItem Tag="{x:Static c:FrameMode.Preserve}" Content="{DynamicResource PreserveFrames}"/><ComboBoxItem Tag="{x:Static c:FrameMode.FirstFrame}" Content="{DynamicResource FirstFrame}"/></ComboBox>
   <TextBlock Text="{DynamicResource Suffix}" Style="{StaticResource Label}"/><TextBox Text="{Binding Suffix,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="Filename suffix"/>
   <TextBlock Text="{DynamicResource Collision}" Style="{StaticResource Label}"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Collision}" AutomationProperties.Name="Filename collision policy"><ComboBoxItem Tag="{x:Static c:CollisionMode.Rename}" Content="{DynamicResource Rename}"/><ComboBoxItem Tag="{x:Static c:CollisionMode.Skip}" Content="{DynamicResource Skip}"/><ComboBoxItem Tag="{x:Static c:CollisionMode.Overwrite}" Content="{DynamicResource Overwrite}"/></ComboBox><TextBlock Text="{DynamicResource OverwriteHint}" FontSize="12" Style="{StaticResource Muted}"/>
  </StackPanel></Expander>
 </StackPanel>
</UserControl>
