<Window x:Class="MatinConverter.Windows.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MatinConverter.Windows.Views" xmlns:c="clr-namespace:MatinConverter.Core;assembly=MatinConverter.Core" Style="{StaticResource {x:Type Window}}" Title="Matin Converter" Width="1180" Height="820" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" Icon="/MatinConverter;component/Assets/icon.png" AllowDrop="True" Drop="FilesDropped">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="ConvertNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsConvert}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="SettingsNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="{Binding Browse}"/><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Convert}"/></Window.InputBindings>
 <ScrollViewer x:Name="MainViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="RootLayout" MinWidth="900" MinHeight="650" Width="{Binding ViewportWidth,ElementName=MainViewport}" Height="{Binding ViewportHeight,ElementName=MainViewport}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="16,28,16,20">
   <StackPanel DockPanel.Dock="Top"><Image Source="/MatinConverter;component/Assets/icon.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Matin" FontSize="23" FontWeight="Bold" FlowDirection="LeftToRight"/><TextBlock Text="Converter" FontSize="14" Foreground="{DynamicResource MutedBrush}" FlowDirection="LeftToRight" Margin="0,0,0,32"/>
    <Button Command="{Binding ConvertPage}" Style="{StaticResource ConvertNav}" AutomationProperties.Name="{DynamicResource Convert}" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal"><Path Data="M3,3 L13,3 13,13 3,13 Z M5,10 L8,7 11,10 M16,5 L21,5 21,18 8,18 M18,2 L21,5 18,8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="24" Height="22" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource Convert}"/></StackPanel></Button>
    <Button Command="{Binding SettingsPage}" Style="{StaticResource SettingsNav}" AutomationProperties.Name="{DynamicResource Settings}" Margin="0"><StackPanel Orientation="Horizontal"><Path Data="M3,5 L21,5 M3,12 L21,12 M3,19 L21,19 M8,2 L8,8 M16,9 L16,15 M8,16 L8,22" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="24" Height="22" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource Settings}"/></StackPanel></Button>
   </StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource About}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom"/><Grid/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Visibility="{Binding IsConvert,Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24"><TextBlock Text="{DynamicResource Convert}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource Subtitle}" Style="{StaticResource Muted}"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="{DynamicResource Files}" Style="{StaticResource Section}"/><WrapPanel><Button Command="{Binding Browse}" Content="{DynamicResource AddFiles}"/><Button Command="{Binding Folder}" Content="{DynamicResource AddFolder}"/></WrapPanel><CheckBox Content="{DynamicResource Recursive}" IsChecked="{Binding Recursive}"/></StackPanel>
      <DockPanel Grid.Row="1" Margin="0,16,0,8" LastChildFill="False"><TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}"/><Button Content="{DynamicResource Clear}" Command="{Binding Clear}" DockPanel.Dock="Right" Padding="8,4" MinHeight="28" FontSize="12" Margin="8,0,0,0"/></DockPanel>
      <Grid Grid.Row="2"><ListBox ItemsSource="{Binding Files}" AutomationProperties.Name="Selected images"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Border CornerRadius="6" Background="{DynamicResource SoftBrush}" Width="48" Height="48"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FlowDirection="LeftToRight" ToolTip="{Binding Path}"/><TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" FlowDirection="LeftToRight"><Run Text="{Binding Extension,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Dimensions,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Size,Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Button Grid.Column="2" Content="×" FontSize="18" Padding="0" Margin="0" MinHeight="32" Height="32" Command="{Binding DataContext.Remove,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{DynamicResource Remove}" AutomationProperties.Name="Remove selected image"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="M5,8 L5,22 27,22 27,8 M8,12 L16,4 24,12 M16,4 L16,18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="48" Height="48" Stretch="Uniform" Margin="0,0,0,16"/><TextBlock Text="{DynamicResource DropTitle}" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource DropHint}" Style="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
      </Grid><TextBlock Grid.Row="3" Text="{DynamicResource SourceSafe}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
     </Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><DockPanel><Button DockPanel.Dock="Bottom" Content="{DynamicResource Start}" Command="{Binding Convert}" Style="{StaticResource Primary}" Margin="0,20,0,0" MinHeight="48"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{DynamicResource Output}" Style="{StaticResource Section}"/><local:OptionsEditor SampleSource="{Binding DataContext.PreviewSource,RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding JobOptions}"/></StackPanel></ScrollViewer></DockPanel></Border>
    </Grid>
   </Grid>
   <ScrollViewer Visibility="{Binding IsSettings,Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
    <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource SettingsSubtitle}" Style="{StaticResource Muted}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource Defaults}" Style="{StaticResource Section}"/><TextBlock Text="{DynamicResource DefaultsHint}" Style="{StaticResource Muted}"/><local:OptionsEditor SampleSource="{Binding DataContext.PreviewSource,RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Settings.Defaults}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource Explorer}" Style="{StaticResource Section}"/><TextBlock Text="{DynamicResource ExplorerHint}" Style="{StaticResource Muted}"/><TextBlock Text="Convert with Matin Converter" FlowDirection="LeftToRight" Margin="0,12,0,8"/><TextBlock Text="{Binding Integration}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/><Button Content="{Binding IntegrationAction}" Command="{Binding ToggleExplorer}" HorizontalAlignment="Left"/><CheckBox x:Name="UseDefaultsBox" Content="{DynamicResource UseDefaults}" IsChecked="{Binding Settings.QuickUsesDefaults}"/>
     <Button Content="{DynamicResource TestQuick}" Command="{Binding TestQuick}" HorizontalAlignment="Left"/><Expander Header="{DynamicResource Output}"><local:OptionsEditor SampleSource="{Binding DataContext.PreviewSource,RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Settings.QuickProfile}"><local:OptionsEditor.Style><Style TargetType="local:OptionsEditor"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=UseDefaultsBox}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></local:OptionsEditor.Style></local:OptionsEditor></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource General}" Style="{StaticResource Section}"/><TextBlock Text="{DynamicResource Zoom}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ZoomChoices}" SelectedItem="{Binding Settings.ZoomPercent}" FlowDirection="LeftToRight"/><CheckBox Content="{DynamicResource QuickAutoClose}" IsChecked="{Binding Settings.QuickAutoClose}"/><TextBlock Text="{DynamicResource Theme}" Style="{StaticResource Label}"/><ComboBox SelectedValue="{Binding Settings.Theme}" SelectedValuePath="Tag"><ComboBoxItem Tag="{x:Static c:AppTheme.System}" Content="{DynamicResource System}"/><ComboBoxItem Tag="{x:Static c:AppTheme.Light}" Content="{DynamicResource Light}"/><ComboBoxItem Tag="{x:Static c:AppTheme.Dark}" Content="{DynamicResource Dark}"/></ComboBox>
     <TextBlock Text="{DynamicResource Language}" Style="{StaticResource Label}"/><ComboBox SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag"><ComboBoxItem Tag="fa" Content="فارسی"/><ComboBoxItem Tag="en" Content="English"/></ComboBox><TextBlock Text="{DynamicResource Parallelism}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ParallelChoices}" SelectedItem="{Binding Settings.Parallelism}" FlowDirection="LeftToRight"/><CheckBox Content="{DynamicResource Notify}" IsChecked="{Binding Settings.Notify}"/><CheckBox Content="{DynamicResource OpenAfter}" IsChecked="{Binding Settings.OpenOutput}"/><WrapPanel Margin="0,12,0,0"><Button Content="{DynamicResource ClearTemp}" Command="{Binding ClearTemp}"/><Button Content="{DynamicResource Reset}" Command="{Binding Reset}"/></WrapPanel>
    </StackPanel></Border><Button Content="{DynamicResource Save}" Command="{Binding Save}" Style="{StaticResource Primary}" HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,20"/>
   </StackPanel></ScrollViewer>
   <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/>
  </Grid>
 </Grid></ScrollViewer>
</Window>
